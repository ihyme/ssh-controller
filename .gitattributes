# Auto detect text files and perform LF normalization
* text=auto

# Dart & Flutter source files
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows specific
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.otf binary
*.ttf binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
